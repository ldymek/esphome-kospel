# AppDaemon add-on: /addon_configs/a0d7b954_appdaemon/apps/apps.yaml
#
# Canonical app configuration (AppDaemon docs: apps.yaml args + !secret).
# Secrets referenced with !secret live in /addon_configs/a0d7b954_appdaemon/secrets.yaml.
# The dashboard "Ustawienia" helpers act as RUNTIME OVERRIDES on top of these:
#   Pstryk key:  input_text.kospel_pstryk_api_key  >  pstryk_api_key arg  >  .pstryk-key file
#   Ollama host: input_text.kospel_llm_host        >  ollama_host arg
kospel_llm:
  module: kospel_llm
  class: KospelLLM
  # optional: per-app API key if your LLM endpoint / load balancer requires one
  # (sent as 'Authorization: Bearer <key>'). Alternatively put it in apps/.llm-key (chmod 600).
  # llm_api_key: !secret llm_api_key
  # optional: CA certificate for an HTTPS LLM endpoint with a private CA (else apps/llm-ca.crt,
  # else the system trust store). Used for LLM calls only; verification is never disabled.
  # llm_ca_file: /config/apps/llm-ca.crt
  ollama_host: http://192.168.1.21:11434     # EDIT ME
  pstryk_api_key: !secret pstryk_api_key     # or leave out and use the UI field / key file
  # presence -> eco planning when everyone is away >30 min (default: all person.* you list here)
  persons: [person.you, person.partner]
  # optional: calendar whose 'urlop'/'wakacje' events force eco mode
  # calendar: calendar.family
