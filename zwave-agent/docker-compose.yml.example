# .81 (garage) zwave-js — host networking (fixes external WS reachability on this Pi).
# The agent manages updates via `docker compose` when ZW_COMPOSE_DIR=/root/zwavejs2mqtt is set.
version: "3.7"
services:
  zwavejs2mqtt:
    container_name: zwavejs2mqtt
    image: zwavejs/zwavejs2mqtt:latest
    restart: always
    tty: true
    stop_signal: SIGINT
    network_mode: host
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }
    environment:
      - SESSION_SECRET=changeme
    devices:
      - "/dev/ttyACM0:/dev/ttyACM0"
    volumes:
      - ./store:/usr/src/app/store
